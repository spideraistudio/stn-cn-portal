[Unit]
Description=STN + CN Next.js frontend
After=network.target mongod.service stn-cn-python@identity.service
Wants=mongod.service stn-cn-python@identity.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=stnnode
Group=stnnode
WorkingDirectory=/srv/stn-cn/current
EnvironmentFile=/etc/stn-cn/app.env
Environment=NODE_ENV=production
Environment=NODE_USE_ENV_PROXY=0
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=200
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/stn-cn/next
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
