+        if mongo.poll() is not None:raise RuntimeError('Disposable MongoDB failed')
+        main()
+    finally:
+        mongo.terminate()
+        try:mongo.wait(timeout=20)
+        except subprocess.TimeoutExpired:mongo.kill()
+
