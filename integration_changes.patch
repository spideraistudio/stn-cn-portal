+    def number(v):
+        if v in (None,''):return v
+        try:
+            n=D(v)
+            if n==0:return '0'
+            text=format(n,'f');return text.rstrip('0').rstrip('.') if '.' in text else text
+        except (ValueError,ArithmeticError):return v
